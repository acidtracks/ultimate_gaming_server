[Unit]
Description=Ultimate Gaming Server — X11 virtual display (VT8)
After=systemd-user-sessions.service
Before=display-manager.service

[Service]
User=acidtracks
Group=acidtracks
ExecStartPre=/usr/bin/rm -f /tmp/.X1-lock /tmp/.X11-unix/X1
ExecStart=/usr/bin/xinit /usr/bin/openbox-session -- /usr/bin/X :1 vt8 -nolisten tcp -config ultimate_gaming_server/ugs-xserver.conf
ExecStartPost=+/bin/bash -c 'until [ -f /tmp/.X1-lock ]; do sleep 0.2; done; sleep 1; DISPLAY=:1 xrandr --output DP-0 --pos 0x0 2>/dev/null; chvt 1'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
