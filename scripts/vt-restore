#!/bin/bash
# Fin de session de jeu : retour sur la session seat0 (SDDM ou Hyprland).
# On détermine le VT dynamiquement pour éviter de hardcoder VT1.
SESSION=$(loginctl list-sessions --no-legend 2>/dev/null | awk '/seat0/{print $1; exit}')
VT=$(loginctl show-session "$SESSION" --property=VTNr --value 2>/dev/null)
sudo chvt "${VT:-1}"
rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ultimate_gaming_server/gaming-session"
